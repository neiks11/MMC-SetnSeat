rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public read-only catalog & business contact settings; admin-only writes
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasAll(['bookingReference', 'customerName', 'rating', 'comment', 'date'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() >= 10
                    && request.resource.data.comment.size() <= 800;
      allow update, delete: if isAdmin();
    }

    // Bookings: customers can create validated bookings; cannot list or read other customers' bookings
    match /bookings/{bookingId} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.customerId);
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['referenceNumber', 'customerName', 'customerPhone', 'eventDate', 'returnDate', 'items', 'totalAmount'])
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.customerName.size() <= 100
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount >= 0;
      allow update, delete: if isAdmin();
    }

    // Strictly internal/admin collections — never readable or writable by public clients
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /damage_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    match /mmc_system/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
